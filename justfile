# Позволяет запускать файл напрямую как скрипт через ./justfile <команда>
#!/usr/bin/env -S just --justfile

# Быстрый алиас для запуска тестов (теперь можно писать `just t`)
alias t := test

# Настройка оболочки
set shell := ["bash", "-cu"]

# Список доступных команд по умолчанию
default:
    @just --list --unsorted

# ==================================================================================== #
# DEVELOPMENT
# ==================================================================================== #

# Запустить проект (принимает любые дополнительные аргументы, например: just run -- --help)
[group: 'dev']
run +args='':
    @cargo run {{ args }}

# Собрать дебаг-бинарник
[group: 'dev']
build:
    @cargo build

# Быстрая проверка: cargo check + clippy
[group: 'dev']
check:
    @cargo check && cargo clippy

# Форматировать код
[group: 'dev']
fmt:
    @cargo fmt

# Запустить тестов (принимает фильтр, например: just test my_func)
[group: 'dev']
test +args='':
    @cargo test {{ args }}

# ==================================================================================== #
# QUALITY CONTROL
# ==================================================================================== #

# Полная проверка CI — формат, строгий линтинг и тесты
[group: 'check']
ci: fmt
    @cargo clippy -- -D warnings
    @cargo test

# ==================================================================================== #
# BUILD
# ==================================================================================== #

# Очистить артефакты сборки
[group: 'misc']
clean:
    @cargo clean

